# Retention Policy: 24 hourly, 7 daily, 4 weekly, 3 monthly
transaction_syslog cron
transaction_log /var/log/btrbk.log
lockfile /var/lock/btrbk.lock
stream_compress zstd
snapshot_preserve_min      {{ btrbk_snapshot_min }}
snapshot_preserve          {{ btrbk_snapshot_freq }}
target_preserve_min        {{ btrbk_target_min }}
target_preserve            {{ btrbk_target_freq }}
{% if btrbk_ssh_identity %}
ssh_identity {{btrbk_ssh_dir }}/{{ btrbk_ssh_identity }}
{% endif %}
# Volume Definitions
{% for sub in btrbk_btrfs_found %}
subvolume {{ sub }}
  snapshot_dir {{ sub }}/.snapshots
  snapshot_name {{ sub | basename }}
  {% for remote in btrbk_remotes | default([]) %}
  target ssh://{{ remote.host }}{{ remote.path }}/{{ inventory_hostname }}/{{ sub | basename }}
  {% endfor %}
{% endfor %}
